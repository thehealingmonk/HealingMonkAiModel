# ---------------------------------------------------------------------------
# HealingMonk — environment variables
# Copy to `.env` (or `.env.local`) and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# --- Database (server-only) ---
# MongoDB Atlas connection string
MONGODB_URI=

# --- Auth (server-only) ---
# Long random string used to sign JWTs
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- URLs ---
# Public base URL used in transactional email links
APP_BASE_URL=http://localhost:3000
# Canonical production origin used for SEO (sitemap, robots, canonical, OG).
# MUST be the real https origin in production, e.g. https://healingmonk.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payments: Razorpay ---
# Key ID is safe to expose to the browser; the secret is server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Optional: only if the API is hosted on a different origin ---
# NEXT_PUBLIC_API_URL=/api
