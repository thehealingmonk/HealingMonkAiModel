# ---------------------------------------------------------------------------
# HealingMonk — environment variables
# Copy to `.env` (or `.env.local`) and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# --- Database (server-only) ---
# MongoDB Atlas connection string
MONGODB_URI=

# --- Auth (server-only) ---
# Long random string used to sign JWTs
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- URLs ---
# Public base URL used in transactional email links
APP_BASE_URL=http://localhost:3000
# Canonical production origin used for SEO (sitemap, robots, canonical, OG).
# MUST be the real https origin in production, e.g. https://healingmonk.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payments: Razorpay ---
# Key ID is safe to expose to the browser; the secret is server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Optional: only if the API is hosted on a different origin ---
# NEXT_PUBLIC_API_URL=/api

# --- WebRTC TURN relay (STRONGLY recommended for production meetings) ---
# STUN alone fails between two different networks behind strict NAT/firewalls
# (mobile CGNAT, corporate/hospital Wi-Fi). A TURN relay is what makes those
# calls connect. Provide your own (self-hosted coturn, or Metered/Twilio/
# Cloudflare) — include UDP, TCP AND a turns: (TLS/443) URL so the call gets
# through the most restrictive networks. Credentials are delivered to the
# browser only as short-lived per-room ICE credentials.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:443?transport=tcp,turns:turn.example.com:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Once your own TURN is set, drop the congested free public relay fallback:
# ICE_DISABLE_FREE_TURN=1
